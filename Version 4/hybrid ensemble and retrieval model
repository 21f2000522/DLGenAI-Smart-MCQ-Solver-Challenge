import os
import numpy as np
import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.svm import LinearSVC
from sklearn.preprocessing import StandardScaler
from sklearn.metrics.pairwise import cosine_similarity
from scipy.sparse import hstack


data_path = "/kaggle/input/competitions/smart-mcq-solver-challenge/"

train = pd.read_csv(data_path + "train.csv")
test = pd.read_csv(data_path + "test.csv")

print("Training shape:", train.shape)
print("Test shape:", test.shape)
train.head()


train_data, valid_data = train_test_split(
    train,
    test_size=0.20,
    random_state=42,
    stratify=train["answer"]
)

train_data = train_data.reset_index(drop=True)
valid_data = valid_data.reset_index(drop=True)

print("Training questions:", train_data.shape)
print("Validation questions:", valid_data.shape)

letters = ["A", "B", "C", "D", "E"]

def create_pair_data(data, include_labels=True):
    pair_texts = []
    pair_labels = []
    numerical_features = []

    for i in range(len(data)):
        question = str(data.iloc[i]["prompt"])
        question_words = question.lower().split()
        question_word_set = set(question_words)

        if include_labels:
            correct_answer = data.iloc[i]["answer"]

        for letter in letters:
            option = str(data.iloc[i][letter])
            option_words = option.lower().split()
            option_word_set = set(option_words)

            common_words = question_word_set.intersection(option_word_set)
            all_words = question_word_set.union(option_word_set)

            question_length = len(question)
            option_length = len(option)
            question_word_count = len(question_words)
            option_word_count = len(option_words)
            common_word_count = len(common_words)

            overlap_ratio = common_word_count / len(option_word_set) if len(option_word_set) > 0 else 0
            jaccard_similarity = common_word_count / len(all_words) if len(all_words) > 0 else 0

            pair_texts.append(question + " " + option)
            numerical_features.append([
                question_length, option_length, question_word_count,
                option_word_count, common_word_count, overlap_ratio,
                jaccard_similarity
            ])

            if include_labels:
                pair_labels.append(1 if letter == correct_answer else 0)

    numerical_features = np.array(numerical_features)

    if include_labels:
        return pair_texts, pair_labels, numerical_features
    return pair_texts, numerical_features

train_text, train_labels, train_number_features = create_pair_data(train_data, True)
valid_text, valid_labels, valid_number_features = create_pair_data(valid_data, True)

print("Training pairs:", len(train_text))
print("Validation pairs:", len(valid_text))
print("Numerical feature shape:", train_number_features.shape)



word_tfidf = TfidfVectorizer(
    stop_words="english",
    ngram_range=(1, 2),
    max_features=50000,
    min_df=1,
    sublinear_tf=True,
    strip_accents="unicode"
)

character_tfidf = TfidfVectorizer(
    analyzer="char_wb",
    ngram_range=(3, 5),
    max_features=30000,
    min_df=2,
    sublinear_tf=True
)

x_train_word = word_tfidf.fit_transform(train_text)
x_valid_word = word_tfidf.transform(valid_text)

x_train_character = character_tfidf.fit_transform(train_text)
x_valid_character = character_tfidf.transform(valid_text)

print("Word TF-IDF shape:", x_train_word.shape)
print("Character TF-IDF shape:", x_train_character.shape)


number_scaler = StandardScaler()

x_train_number = number_scaler.fit_transform(train_number_features)
x_valid_number = number_scaler.transform(valid_number_features)

x_train_combined = hstack([x_train_word, x_train_character, x_train_number]).tocsr()
x_valid_combined = hstack([x_valid_word, x_valid_character, x_valid_number]).tocsr()

print("Combined training shape:", x_train_combined.shape)
print("Combined validation shape:", x_valid_combined.shape)


logistic_model = LogisticRegression(
    C=2,
    max_iter=3000,
    class_weight="balanced",
    random_state=42
)

svm_model = LinearSVC(
    C=1,
    class_weight="balanced",
    random_state=42
)

logistic_model.fit(x_train_combined, train_labels)
svm_model.fit(x_train_combined, train_labels)

logistic_valid_score = logistic_model.predict_proba(x_valid_combined)[:, 1]
svm_valid_score = svm_model.decision_function(x_valid_combined)

print("Logistic scores:", logistic_valid_score[:5])
print("SVM scores:", svm_valid_score[:5])


question_tfidf = TfidfVectorizer(
    stop_words="english",
    ngram_range=(1, 2),
    max_features=30000,
    sublinear_tf=True
)

train_question_matrix = question_tfidf.fit_transform(train_data["prompt"].astype(str))
valid_question_matrix = question_tfidf.transform(valid_data["prompt"].astype(str))

similarity_matrix = cosine_similarity(valid_question_matrix, train_question_matrix)
retrieval_valid_scores = []

for i in range(len(valid_data)):
    one_question_similarity = similarity_matrix[i]
    top_indices = one_question_similarity.argsort()[-5:][::-1]
    option_scores = {"A": 0, "B": 0, "C": 0, "D": 0, "E": 0}

    for index in top_indices:
        retrieved_answer = train_data.iloc[index]["answer"]
        similarity_value = one_question_similarity[index]
        option_scores[retrieved_answer] += similarity_value

    for letter in letters:
        retrieval_valid_scores.append(option_scores[letter])

retrieval_valid_scores = np.array(retrieval_valid_scores)
print(retrieval_valid_scores[:10])


def normalise_question_scores(scores, number_of_questions):
    normalised_scores = []
    start = 0

    for i in range(number_of_questions):
        one_question = scores[start:start + 5]
        minimum_score = one_question.min()
        maximum_score = one_question.max()

        if maximum_score == minimum_score:
            one_question_normalised = np.zeros(5)
        else:
            one_question_normalised = (one_question - minimum_score) / (maximum_score - minimum_score)

        normalised_scores.extend(one_question_normalised)
        start += 5

    return np.array(normalised_scores)

logistic_valid_normalised = normalise_question_scores(logistic_valid_score, len(valid_data))
svm_valid_normalised = normalise_question_scores(svm_valid_score, len(valid_data))
retrieval_valid_normalised = normalise_question_scores(retrieval_valid_scores, len(valid_data))

final_valid_score = (
    0.45 * logistic_valid_normalised
    + 0.35 * svm_valid_normalised
    + 0.20 * retrieval_valid_normalised
)

print(final_valid_score[:10])


def create_top_three_answers(scores, number_of_questions):
    predictions = []
    start = 0

    for i in range(number_of_questions):
        one_question = scores[start:start + 5]
        top_three = one_question.argsort()[-3:][::-1]

        answer = ""
        for position in top_three:
            answer += letters[position] + " "

        predictions.append(answer.strip())
        start += 5

    return predictions

def calculate_map3(actual_answers, predicted_answers):
    total_score = 0
    actual_answers = actual_answers.reset_index(drop=True)

    for i in range(len(actual_answers)):
        correct_answer = actual_answers.iloc[i]
        top_three = predicted_answers[i].split()

        if correct_answer == top_three[0]:
            total_score += 1
        elif correct_answer == top_three[1]:
            total_score += 0.5
        elif correct_answer == top_three[2]:
            total_score += 1 / 3

    return total_score / len(actual_answers)

valid_predictions = create_top_three_answers(final_valid_score, len(valid_data))
validation_map3 = calculate_map3(valid_data["answer"], valid_predictions)

print("Validation MAP@3:", validation_map3)
print(valid_predictions[:10])


full_train_text, full_train_labels, full_train_number_features = create_pair_data(train, True)
test_text, test_number_features = create_pair_data(test, False)

print("Complete training pairs:", len(full_train_text))
print("Test pairs:", len(test_text))

final_word_tfidf = TfidfVectorizer(
    stop_words="english", ngram_range=(1, 2), max_features=50000,
    min_df=1, sublinear_tf=True, strip_accents="unicode"
)

final_character_tfidf = TfidfVectorizer(
    analyzer="char_wb", ngram_range=(3, 5), max_features=30000,
    min_df=2, sublinear_tf=True
)

x_full_word = final_word_tfidf.fit_transform(full_train_text)
x_test_word = final_word_tfidf.transform(test_text)

x_full_character = final_character_tfidf.fit_transform(full_train_text)
x_test_character = final_character_tfidf.transform(test_text)

final_number_scaler = StandardScaler()
x_full_number = final_number_scaler.fit_transform(full_train_number_features)
x_test_number = final_number_scaler.transform(test_number_features)

x_full_combined = hstack([x_full_word, x_full_character, x_full_number]).tocsr()
x_test_combined = hstack([x_test_word, x_test_character, x_test_number]).tocsr()

final_logistic_model = LogisticRegression(
    C=2, max_iter=3000, class_weight="balanced", random_state=42
)

final_svm_model = LinearSVC(
    C=1, class_weight="balanced", random_state=42
)

final_logistic_model.fit(x_full_combined, full_train_labels)
final_svm_model.fit(x_full_combined, full_train_labels)

logistic_test_score = final_logistic_model.predict_proba(x_test_combined)[:, 1]
svm_test_score = final_svm_model.decision_function(x_test_combined)

print("Final models trained successfully")


final_question_tfidf = TfidfVectorizer(
    stop_words="english",
    ngram_range=(1, 2),
    max_features=30000,
    sublinear_tf=True
)

full_train_question_matrix = final_question_tfidf.fit_transform(train["prompt"].astype(str))
test_question_matrix = final_question_tfidf.transform(test["prompt"].astype(str))

test_similarity_matrix = cosine_similarity(test_question_matrix, full_train_question_matrix)
retrieval_test_scores = []

for i in range(len(test)):
    one_question_similarity = test_similarity_matrix[i]
    top_indices = one_question_similarity.argsort()[-5:][::-1]
    option_scores = {"A": 0, "B": 0, "C": 0, "D": 0, "E": 0}

    for index in top_indices:
        retrieved_answer = train.iloc[index]["answer"]
        similarity_value = one_question_similarity[index]
        option_scores[retrieved_answer] += similarity_value

    for letter in letters:
        retrieval_test_scores.append(option_scores[letter])

retrieval_test_scores = np.array(retrieval_test_scores)
print(retrieval_test_scores[:10])


logistic_test_normalised = normalise_question_scores(logistic_test_score, len(test))
svm_test_normalised = normalise_question_scores(svm_test_score, len(test))
retrieval_test_normalised = normalise_question_scores(retrieval_test_scores, len(test))

final_test_score = (
    0.45 * logistic_test_normalised
    + 0.35 * svm_test_normalised
    + 0.20 * retrieval_test_normalised
)

final_answers = create_top_three_answers(final_test_score, len(test))

print(final_answers[:10])
print("Number of predictions:", len(final_answers))
print("Number of test rows:", len(test))


submission = pd.DataFrame()
submission["ID"] = test["id"]
submission["Prediction"] = final_answers

submission.to_csv("submission.csv", index=False)

