import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression


data_path = "/kaggle/input/competitions/smart-mcq-solver-challenge/"

train = pd.read_csv(data_path + "train.csv")
test = pd.read_csv(data_path + "test.csv")
sample_submission = pd.read_csv(data_path + "sample_submission.csv")

print("Training shape:", train.shape)
print("Test shape:", test.shape)
print("Submission shape:", sample_submission.shape)

train.head()


train_data, valid_data = train_test_split(
    train,
    test_size=0.20,
    random_state=42,
    stratify=train["answer"]
)

train_data = train_data.reset_index(drop=True)
valid_data = valid_data.reset_index(drop=True)

print("Training questions:", train_data.shape)
print("Validation questions:", valid_data.shape)

letters = ["A", "B", "C", "D", "E"]


def create_pairs(data, include_answer=True):

    text_list = []
    label_list = []

    for i in range(len(data)):
        question = str(data.iloc[i]["prompt"])

        if include_answer:
            correct_answer = data.iloc[i]["answer"]

        for letter in letters:
            option = str(data.iloc[i][letter])

            full_text = question + " " + option
            text_list.append(full_text)

            if include_answer:
                if letter == correct_answer:
                    label_list.append(1)
                else:
                    label_list.append(0)

    if include_answer:
        return text_list, label_list
    else:
        return text_list





train_text, train_labels = create_pairs(
    train_data,
    include_answer=True
)

valid_text, valid_labels = create_pairs(
    valid_data,
    include_answer=True
)

print("Training pairs:", len(train_text))
print("Training labels:", len(train_labels))

print("Validation pairs:", len(valid_text))
print("Validation labels:", len(valid_labels))


tfidf = TfidfVectorizer(
    stop_words="english",
    ngram_range=(1, 2),
    max_features=50000,
    min_df=1,
    sublinear_tf=True,
    strip_accents="unicode"
)

x_train = tfidf.fit_transform(train_text)

x_valid = tfidf.transform(valid_text)

print("Training TF-IDF shape:", x_train.shape)
print("Validation TF-IDF shape:", x_valid.shape)


model = LogisticRegression(
    C=2,
    max_iter=3000,
    class_weight="balanced",
    random_state=42
)

model.fit(x_train, train_labels)
valid_probability = model.predict_proba(x_valid)
valid_correct_probability = valid_probability[:, 1]
print(valid_correct_probability[:10])


valid_predictions = []
start = 0

for i in range(len(valid_data)):
    one_question_probability = valid_correct_probability[start:start + 5]
    top_three_positions = one_question_probability.argsort()[-3:]
    top_three_positions = top_three_positions[::-1]

    answer = ""

    for position in top_three_positions:
        answer = answer + letters[position] + " "

    valid_predictions.append(answer.strip())
    start = start + 5

      print(valid_predictions[:10])


def calculate_map3(actual_answers, predicted_answers):

    total_score = 0

    for i in range(len(actual_answers)):
        correct_answer = actual_answers.iloc[i]
        top_three = predicted_answers[i].split()

        if correct_answer == top_three[0]:
            total_score = total_score + 1

        elif correct_answer == top_three[1]:
            total_score = total_score + 0.5

        elif correct_answer == top_three[2]:
            total_score = total_score + (1 / 3)

    map3_score = total_score / len(actual_answers)

    return map3_score



validation_map3 = calculate_map3(
    valid_data["answer"],
    valid_predictions
)

print("Validation MAP@3:", validation_map3)


validation_result = pd.DataFrame()
validation_result["Correct Answer"] = valid_data["answer"]
validation_result["Top 3 Prediction"] = valid_predictions

validation_result.head(10)


full_train_text, full_train_labels = create_pairs(
    train,
    include_answer=True
)

test_text = create_pairs(
    test,
    include_answer=False
)

print("Complete training pairs:", len(full_train_text))
print("Test pairs:", len(test_text))


final_tfidf = TfidfVectorizer(
    stop_words="english",
    ngram_range=(1, 2),
    max_features=50000,
    min_df=1,
    sublinear_tf=True,
    strip_accents="unicode"
)

x_full_train = final_tfidf.fit_transform(full_train_text)
x_test = final_tfidf.transform(test_text)


final_model = LogisticRegression(
    C=2,
    max_iter=3000,
    class_weight="balanced",
    random_state=42
)

final_model.fit(x_full_train, full_train_labels)
test_probability = final_model.predict_proba(x_test)
test_correct_probability = test_probability[:, 1]



final_answers = []
start = 0

for i in range(len(test)):
    one_question = test_correct_probability[start:start + 5]
    top_three = one_question.argsort()[-3:]
    top_three = top_three[::-1]
    answer = ""

    for j in top_three:
        answer = answer + letters[j] + " "

    final_answers.append(answer.strip())

    start = start + 5

print(final_answers[:10])
print("Number of predictions:", len(final_answers))
print("Number of test rows:", len(test))


submission = pd.DataFrame()

submission["ID"] = test["id"]

submission["Prediction"] = final_answers

submission.to_csv("submission.csv", index=False)

print(submission.head())
print(submission.shape)
print("Submission file created")
