        for batch in tqdm(data_loader, desc="Test prediction"):
            batch = move_batch_to_device(batch)
            with torch.amp.autocast("cuda", enabled=use_amp):
                outputs = model(**batch)
            probabilities = torch.softmax(outputs.logits, dim=1)
            positive_probabilities.extend(probabilities[:, 1].detach().cpu().numpy())
    return np.array(positive_probabilities)

