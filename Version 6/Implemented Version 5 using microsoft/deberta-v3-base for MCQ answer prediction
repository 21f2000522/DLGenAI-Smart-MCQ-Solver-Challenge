class MCQPairDataset(Dataset):
    def __init__(self, dataframe, tokenizer, max_length, include_labels=True):
        self.dataframe = dataframe.reset_index(drop=True)
        self.tokenizer = tokenizer
        self.max_length = max_length
        self.include_labels = include_labels

    def __len__(self):
        return len(self.dataframe)

    def __getitem__(self, index):
        prompt = str(self.dataframe.iloc[index]["prompt"])
        option = str(self.dataframe.iloc[index]["option"])
        encoding = self.tokenizer(
            prompt,
            option,
            truncation=True,
            max_length=self.max_length
        )
        if self.include_labels:
            encoding["labels"] = int(self.dataframe.iloc[index]["label"])
        return encoding



