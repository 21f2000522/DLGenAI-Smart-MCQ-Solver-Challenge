def create_top_three_answers(scores, number_of_questions):
    predictions = []
    for question_index in range(number_of_questions):
        start = question_index * 5
        one_question_scores = scores[start:start + 5]
        top_three_positions = np.argsort(one_question_scores)[-3:][::-1]
        predictions.append(" ".join([letters[position] for position in top_three_positions]))
    return predictions

def calculate_map3(actual_answers, predicted_answers):
    actual_answers = actual_answers.reset_index(drop=True)
    total_score = 0
    for index in range(len(actual_answers)):
        correct_answer = actual_answers.iloc[index]
        top_three = predicted_answers[index].split()
        if correct_answer == top_three[0]:
            total_score += 1.0
        elif correct_answer == top_three[1]:
            total_score += 0.5
        elif correct_answer == top_three[2]:
            total_score += 1 / 3
    return total_score / len(actual_answers)



