def create_pair_dataframe(data, include_labels=True):
    rows = []
    for question_index in range(len(data)):
        prompt = str(data.iloc[question_index]["prompt"])
        if include_labels:
            correct_answer = str(data.iloc[question_index]["answer"])
        for option_position, letter in enumerate(letters):
            option = str(data.iloc[question_index][letter])
            row = {
                "question_index": question_index,
                "option_letter": letter,
                "option_position": option_position,
                "prompt": prompt,
                "option": option
            }
            if include_labels:
                row["label"] = 1 if letter == correct_answer else 0
            rows.append(row)
    return pd.DataFrame(rows)

