class MCQDataset(Dataset):

    def __init__(
        self,
        dataframe,
        tokenizer,
        max_length,
        include_labels=True
    ):

        self.dataframe = (
            dataframe
            .reset_index(drop=True)
        )

        self.tokenizer = tokenizer
        self.max_length = max_length
        self.include_labels = include_labels

        self.answer_to_number = {
            "A": 0,
            "B": 1,
            "C": 2,
            "D": 3,
            "E": 4
        }


    def __len__(self):

        return len(
            self.dataframe
        )


    def __getitem__(self, index):

        row = self.dataframe.iloc[index]
        prompt = str(row["prompt"])
        options = []

        for letter in letters:

            option = str(row[letter])
            options.append(option)

        repeated_prompts = [
            prompt
            for _ in range(5)
        ]

        encoding = self.tokenizer(
            repeated_prompts,
            options,
            truncation=True,
            max_length=self.max_length,
            padding=False
        )

        item = {
            key: value
            for key, value in encoding.items()
        }

        if self.include_labels:

            answer = str(
                row["answer"]
            )

            item["labels"] = (
                self.answer_to_number[
                    answer
                ]
            )

        return item





class MultipleChoiceCollator:

    def __init__(self, tokenizer):
        self.tokenizer = tokenizer


    def __call__(self, features):

        labels = None
        if "labels" in features[0]:

            labels = [
                feature.pop("labels")
                for feature in features
            ]

        batch_size = len(features)
        number_of_choices = len(features[0]["input_ids"])
        flattened_features = []

        for feature in features:

            for choice_index in range(number_of_choices):
                one_choice = {}

                for key, value in feature.items():
                    one_choice[key] = (value[choice_index])

                flattened_features.append(one_choice)

        batch = self.tokenizer.pad(
            flattened_features,
            padding=True,
            return_tensors="pt"
        )

        for key, value in batch.items():

            batch[key] = value.view(
                batch_size,
                number_of_choices,
                -1
            )

        if labels is not None:

            batch["labels"] = torch.tensor(
                labels,
                dtype=torch.long
            )

        return batch


