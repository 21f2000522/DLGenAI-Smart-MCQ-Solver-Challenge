def probabilities_to_predictions(probabilities):   

    predictions = []

    for row in probabilities:

        top_three_positions = (np.argsort(row)[-3:][::-1])
        top_three_letters = []

        for position in top_three_positions:

            top_three_letters.append(letters[position])

        prediction = " ".join(top_three_letters)

        predictions.append(prediction)

    return predictions


    
def calculate_map3(actual_answers,predicted_answers):

    actual_answers = (actual_answers.reset_index(drop=True))
    total_score = 0.0

    for index in range(len(actual_answers)):
        actual = str(actual_answers.iloc[index])

        predicted = (predicted_answers[index].split())

        if actual == predicted[0]:
            total_score += 1.0

        elif actual == predicted[1]:
            total_score += 0.5

        elif actual == predicted[2]:
            total_score += 1 / 3

    map3 = (total_score / len(actual_answers))

    return map3



def train_one_epoch(
    model,
    data_loader,
    optimizer,
    scheduler,
    scaler,
    use_amp
):

    model.train()

    total_loss = 0.0

    optimizer.zero_grad(
        set_to_none=True
    )

    progress_bar = tqdm(
        data_loader,
        desc="Training"
    )

    for step, batch in enumerate(
        progress_bar
    ):

        batch = {
            key: value.to(
                device,
                non_blocking=True
            )
            for key, value in batch.items()
        }

        with torch.amp.autocast(
            device_type="cuda",
            dtype=torch.float16,
            enabled=use_amp
        ):

            outputs = model(
                **batch
            )

            loss = (
                outputs.loss /
                gradient_accumulation_steps
            )

        scaler.scale(
            loss
        ).backward()

        should_update = (
            (
                step + 1
            ) % gradient_accumulation_steps == 0
            or
            (
                step + 1
            ) == len(data_loader)
        )

        if should_update:

            scaler.unscale_(
                optimizer
            )

            torch.nn.utils.clip_grad_norm_(
                model.parameters(),
                max_norm=1.0
            )

            scaler.step(
                optimizer
            )

            scaler.update()

            optimizer.zero_grad(
                set_to_none=True
            )

            scheduler.step()

        original_loss = (
            loss.item() *
            gradient_accumulation_steps
        )

        total_loss += original_loss

        progress_bar.set_postfix({
            "loss":
            total_loss / (step + 1)
        })

    average_loss = (
        total_loss /
        len(data_loader)
    )

    return average_loss




def validate_model(
    model,
    data_loader,
    use_amp
):

    model.eval()

    total_loss = 0.0
    all_probabilities = []

    progress_bar = tqdm(
        data_loader,
        desc="Validation"
    )

    with torch.no_grad():

        for batch in progress_bar:

            batch = {
                key: value.to(
                    device,
                    non_blocking=True
                )
                for key, value in batch.items()
            }

            with torch.amp.autocast(
                device_type="cuda",
                dtype=torch.float16,
                enabled=use_amp
            ):

                outputs = model(
                    **batch
                )

            total_loss += (
                outputs.loss.item()
            )

            probabilities = torch.softmax(
                outputs.logits,
                dim=1
            )

            all_probabilities.append(
                probabilities
                .detach()
                .cpu()
                .numpy()
            )

    all_probabilities = np.concatenate(
        all_probabilities,
        axis=0
    )

    average_loss = (
        total_loss /
        len(data_loader)
    )

    return (
        average_loss,
        all_probabilities
    )




