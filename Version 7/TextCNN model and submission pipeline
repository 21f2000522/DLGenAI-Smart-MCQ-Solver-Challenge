class MCQDataset(Dataset):

    def __init__(
        self,
        dataframe,
        word_to_number,
        max_length,
        is_test=False
    ):
        self.dataframe = dataframe.reset_index(drop=True)
        self.word_to_number = word_to_number
        self.max_length = max_length
        self.is_test = is_test

    def __len__(self):
        return len(self.dataframe)

    def __getitem__(self, index):
        row = self.dataframe.iloc[index]

        prompt = str(row["prompt"])

        all_option_tokens = []

        for option in option_columns:
            option_text = str(row[option])

            # Add a separator word between question and option
            combined_text = prompt + " separator " + option_text

            token_numbers = text_to_numbers(
                combined_text,
                self.word_to_number,
                self.max_length
            )

            all_option_tokens.append(token_numbers)

        input_ids = torch.tensor(
            all_option_tokens,
            dtype=torch.long
        )

        if self.is_test:
            return {
                "input_ids": input_ids
            }

        label = torch.tensor(
            int(row["label"]),
            dtype=torch.long
        )

        return {
            "input_ids": input_ids,
            "label": label
        }



