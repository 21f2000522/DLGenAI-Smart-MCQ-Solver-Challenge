def simple_tokenizer(text):
    text = str(text).lower()

    # Keep letters, numbers and basic apostrophes
    text = re.sub(r"[^a-z0-9']", " ", text)

    # Remove additional spaces
    text = re.sub(r"\s+", " ", text).strip()

    words = text.split()

    return words


