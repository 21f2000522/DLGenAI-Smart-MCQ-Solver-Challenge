def text_to_numbers(text, word_to_number, max_length):
    words = simple_tokenizer(text)

    token_numbers = []

    for word in words:
        if word in word_to_number:
            token_numbers.append(word_to_number[word])
        else:
            token_numbers.append(word_to_number["<UNK>"])

    # Shorten long sequences
    token_numbers = token_numbers[:max_length]

    # Add padding to short sequences
    number_of_padding_tokens = max_length - len(token_numbers)

    token_numbers = token_numbers + (
        [word_to_number["<PAD>"]] * number_of_padding_tokens
    )

    return token_numbers



