def calculate_map_at_3(correct_labels, prediction_probabilities):
    total_score = 0

    for row_number in range(len(correct_labels)):
        correct_answer = correct_labels[row_number]

        option_probabilities = prediction_probabilities[row_number]

        top_three = np.argsort(option_probabilities)[::-1][:3]

        if correct_answer == top_three[0]:
            total_score += 1.0

        elif correct_answer == top_three[1]:
            total_score += 0.5

        elif correct_answer == top_three[2]:
            total_score += 1.0 / 3.0

    map_at_3 = total_score / len(correct_labels)

    return map_at_3





