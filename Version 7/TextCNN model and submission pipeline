class TextCNNMultipleChoice(nn.Module):

    def __init__(
        self,
        vocabulary_size,
        embedding_size,
        number_of_filters,
        dropout_rate
    ):
        super().__init__()

        # Randomly initialised embedding layer
        self.embedding = nn.Embedding(
            num_embeddings=vocabulary_size,
            embedding_dim=embedding_size,
            padding_idx=0
        )

        # Convolution layers with different kernel sizes
        self.convolution_2 = nn.Conv1d(
            in_channels=embedding_size,
            out_channels=number_of_filters,
            kernel_size=2
        )

        self.convolution_3 = nn.Conv1d(
            in_channels=embedding_size,
            out_channels=number_of_filters,
            kernel_size=3
        )

        self.convolution_4 = nn.Conv1d(
            in_channels=embedding_size,
            out_channels=number_of_filters,
            kernel_size=4
        )

        self.relu = nn.ReLU()

        self.dropout = nn.Dropout(dropout_rate)

        # Each option receives one score
        self.output_layer = nn.Linear(
            number_of_filters * 3,
            1
        )

    def apply_convolution(self, embedded_text, convolution_layer):
        convolution_output = convolution_layer(embedded_text)

        convolution_output = self.relu(convolution_output)

        # Global max pooling
        pooled_output = torch.max(
            convolution_output,
            dim=2
        ).values

        return pooled_output

    def forward(self, input_ids):
        batch_size = input_ids.size(0)
        number_of_options = input_ids.size(1)
        sequence_length = input_ids.size(2)

        # Changing shape from:
        # batch × 5 × sequence
        #
        # to:
        # (batch × 5) × sequence
        input_ids = input_ids.view(
            batch_size * number_of_options,
            sequence_length
        )

        # Shape:
        # (batch × 5) × sequence × embedding
        embedded_text = self.embedding(input_ids)

        # Conv1D expects:
        # batch × embedding × sequence
        embedded_text = embedded_text.permute(0, 2, 1)

        pooled_2 = self.apply_convolution(
            embedded_text,
            self.convolution_2
        )

        pooled_3 = self.apply_convolution(
            embedded_text,
            self.convolution_3
        )

        pooled_4 = self.apply_convolution(
            embedded_text,
            self.convolution_4
        )

        combined_features = torch.cat(
            [pooled_2, pooled_3, pooled_4],
            dim=1
        )

        combined_features = self.dropout(combined_features)

        # One score for every option
        option_scores = self.output_layer(combined_features)

        # Changing shape to:
        # batch × 5
        option_scores = option_scores.view(
            batch_size,
            number_of_options
        )

        return option_scores



