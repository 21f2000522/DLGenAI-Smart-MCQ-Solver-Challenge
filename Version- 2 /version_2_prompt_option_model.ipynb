import pandas as pd
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression

train = pd.read_csv("/kaggle/input/competitions/smart-mcq-solver-challenge/train.csv")
test = pd.read_csv("/kaggle/input/competitions/smart-mcq-solver-challenge/test.csv")

print(train.shape)
print(test.shape)
train.head()

letters = ["A", "B", "C", "D", "E"]

new_train_text = []
new_train_answer = []

for i in range(len(train)):
    question = str(train.iloc[i]["prompt"])
    correct_answer = train.iloc[i]["answer"]

    for letter in letters:
        option = str(train.iloc[i][letter])

        full_text = question + " " + option
        new_train_text.append(full_text)

        if letter == correct_answer:
            new_train_answer.append(1)
        else:
            new_train_answer.append(0)



print("Number of training texts:",len(new_train_text))
print("Number of training labels:",  len(new_train_answer))


print(new_train_text[0])
print(new_train_answer[0])


new_test_text = []

for i in range(len(test)):
    question = str(test.iloc[i]["prompt"])

    for letter in letters:
        option = str(test.iloc[i][letter])
        full_text = question + " " + option
        new_test_text.append(full_text)



print("Number of test texts:",len(new_test_text))


tfidf = TfidfVectorizer(
    stop_words="english",
    ngram_range=(1, 2),
    max_features=30000,
    min_df=2
)



x_train = tfidf.fit_transform(new_train_text)
x_test = tfidf.transform(new_test_text)

print(x_train.shape)
print(x_test.shape)

model = LogisticRegression(
    max_iter=2000,
    class_weight="balanced",
    random_state=42
)

model.fit(x_train, new_train_answer)
probability = model.predict_proba(x_test)
correct_probability = probability[:, 1]


print(correct_probability[:10])



final_answers = []
start = 0

for i in range(len(test)):

    one_question = correct_probability[start:start + 5]
    top_three = one_question.argsort()[-3:]
    top_three = top_three[::-1]

    answer = ""

    for j in top_three:
        answer = answer + letters[j] + " "

    final_answers.append(answer.strip())
    start = start + 5

print(final_answers[:10])




submission = pd.DataFrame()

submission["ID"] = test["id"]

submission["Prediction"] = final_answers

submission.to_csv("submission.csv", index=False)

print(submission.head())
print(submission.shape)
print("Submission file created")
